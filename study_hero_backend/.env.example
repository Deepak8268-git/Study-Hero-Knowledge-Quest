PORT=4000
NODE_ENV=production

FRONTEND_URL=https://your-vercel-app.vercel.app
APP_URL=https://your-vercel-app.vercel.app
CORS_ORIGINS=
JSON_BODY_LIMIT=1mb

JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
REMEMBER_ME_REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=study_hero_refresh
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=none

PASSWORD_MIN_LENGTH=8
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
EMAIL_VERIFICATION_EXPIRES_MINUTES=1440
VERIFICATION_RESEND_COOLDOWN_MINUTES=5
PASSWORD_RESET_EXPIRES_MINUTES=60

RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=50
LOGIN_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_MAX=5
VERIFICATION_RATE_LIMIT_MAX=5

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM="Study Hero <no-reply@example.com>"

DB_HOST=your-cloud-mysql-host
DB_PORT=3306
DB_USER=your-cloud-mysql-user
DB_PASSWORD=your-cloud-mysql-password
DB_NAME=study_hero

MISTRAL_API_KEY=your-mistral-api-key